class Solution {
    public ListNode reverseKGroup(ListNode head, int k) {
        ListNode temp = head;

        
        for (int i = 0; i < k; i++) {
            if (temp == null) {
                return head;
            }
            temp = temp.next;
        }

        
        ListNode newHead = reverseKGroup(temp, k);

      
        temp = head;

        for (int i = 0; i < k; i++) {
            ListNode next = temp.next;
            temp.next = newHead;
            newHead = temp;
            temp = next;
        }

        return newHead;
    }
}
